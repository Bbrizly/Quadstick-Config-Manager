<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>QuadStick.Integration.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- This is intentionally a cross-layer compatibility/integration suite.
         Layer dependency rules are enforced independently by App.Tests. -->
    <ProjectReference Include="../../src/QuadStick.Core/QuadStick.Core.csproj" />
    <ProjectReference Include="../../src/QuadStick.Infrastructure/QuadStick.Infrastructure.csproj" />
    <ProjectReference Include="../../src/QuadStick.App/QuadStick.App.csproj" />
    <None Include="corpus/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
