<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuadStickConfigManager</AssemblyName>
    <Version>1.6.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- When the gitignored local client file exists, compile out the
       committed placeholder in GoogleClient.cs. -->
  <PropertyGroup Condition="Exists('GoogleClient.Local.cs')">
    <DefineConstants>$(DefineConstants);GOOGLE_CLIENT_LOCAL</DefineConstants>
  </PropertyGroup>

  <!-- Same arrangement for the PostHog project token. Without the local file
       the placeholder's empty token compiles in and telemetry stays off. -->
  <PropertyGroup Condition="Exists('TelemetryToken.Local.cs')">
    <DefineConstants>$(DefineConstants);TELEMETRY_TOKEN_LOCAL</DefineConstants>
  </PropertyGroup>

  <!-- Every user-facing string. The generator writes a strongly typed
       Strings class into obj/ at build time, so a renamed key is a compile
       error, not a blank label at runtime. Translations are Strings.<lang>.resx
       next to this one; MSBuild turns each into a satellite assembly. -->
  <ItemGroup>
    <!-- The pseudo language is a debugging aid, not something to ship. -->
    <EmbeddedResource Remove="Strings.qps-ploc.resx" Condition="'$(Configuration)' == 'Release'" />
    <EmbeddedResource Update="Strings.resx" Generator="MSBuild:Compile"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="QuadStick.App"
                      StronglyTypedClassName="Strings" PublicClass="true"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/AppIcon.png" />
    <AvaloniaResource Include="Assets/QuadStick.png" />
    <AvaloniaResource Include="Assets/QuadStickBack.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QuadStick.App.Tests" />
    <InternalsVisibleTo Include="RenderPreview" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="PostHog" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../QuadStick.Format/QuadStick.Format.csproj" />
  </ItemGroup>
</Project>
