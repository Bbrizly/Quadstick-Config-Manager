<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuadStickConfigManager</AssemblyName>
    <Version>1.6.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('GoogleClient.Local.cs')">
    <DefineConstants>$(DefineConstants);GOOGLE_CLIENT_LOCAL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('TelemetryToken.Local.cs')">
    <DefineConstants>$(DefineConstants);TELEMETRY_TOKEN_LOCAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/AppIcon.png" />
    <AvaloniaResource Include="Assets/QuadStick.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QuadStick.App.Tests" />
    <InternalsVisibleTo Include="RenderPreview" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="PostHog" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../QuadStick.Core/QuadStick.Core.csproj" />
    <ProjectReference Include="../QuadStick.Application/QuadStick.Application.csproj" />
    <ProjectReference Include="../QuadStick.Infrastructure/QuadStick.Infrastructure.csproj" />
  </ItemGroup>
</Project>
