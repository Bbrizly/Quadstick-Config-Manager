<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuadStick.App"
        x:Class="QuadStick.App.MainWindow"
        Title="Quadstick: Config Manager (unofficial)"
        Icon="avares://QuadStickConfigManager/Assets/AppIcon.png"
        Width="1180" Height="920" MinWidth="760" MinHeight="560">
  <Panel x:Name="RootHost">
  <LayoutTransformControl x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
  <Grid x:Name="RootPanel" RowDefinitions="Auto,*">
  <!-- Persistent application chrome. Home and Editor are pages inside QCM,
       not separate utilities with unrelated headers. The major destinations
       stay in the same place while the content below changes. -->
  <Border Grid.Row="0" Classes="appchrome">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!-- The mark is the way home. It is the biggest, most predictable target
           in the window and it is in the corner every other app puts one, so
           anyone aiming with a mouth stick or a head mouse can always get back
           without hunting the nav row. -->
      <Button x:Name="ShellBrandButton" Grid.Column="0" Classes="shellbrandbutton"
              VerticalAlignment="Center"
              AutomationProperties.Name="QuadStick Config Manager. Go to Home"
              ToolTip.Tip="Go to Home">
        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="9" ClipToBounds="True">
            <Image Source="avares://QuadStickConfigManager/Assets/AppIcon.png" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="QCM" Classes="shellbrand"/>
            <TextBlock x:Name="ShellBrandCaption" Text="QuadStick Config Manager" Classes="shellcaption"/>
          </StackPanel>
        </StackPanel>
      </Button>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="ShellHomeButton" Classes="shellnav active"
                AutomationProperties.Name="Home">
          <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{DynamicResource IconHome}"/><TextBlock x:Name="ShellHomeLabel" Text="Home"/></StackPanel>
        </Button>
        <Button x:Name="ShellNewButton" Classes="shellnav"
                AutomationProperties.Name="Create a new profile">
          <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{DynamicResource IconAdd}"/><TextBlock x:Name="ShellNewLabel" Text="New"/></StackPanel>
        </Button>
        <Button x:Name="ShellOpenButton" Classes="shellnav"
                AutomationProperties.Name="Open a profile file">
          <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{DynamicResource IconFolder}"/><TextBlock x:Name="ShellOpenLabel" Text="Open"/></StackPanel>
        </Button>
        <Button x:Name="ShellDeviceButton" Classes="shellnav"
                AutomationProperties.Name="Manage files on your QuadStick">
          <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{DynamicResource IconDevice}"/><TextBlock x:Name="ShellDeviceLabel" Text="Device"/></StackPanel>
        </Button>
        <Button x:Name="ShellCommunityButton" Classes="shellnav"
                AutomationProperties.Name="Browse community profiles">
          <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{DynamicResource IconCommunity}"/><TextBlock x:Name="ShellCommunityLabel" Text="Community"/></StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="AppearancePicker" MinWidth="112"
                  AutomationProperties.Name="Appearance: choose System, Light, or Dark theme"/>
        <Button x:Name="SettingsButton" Classes="icon shellutility" Content="⚙" FontSize="19"
                AutomationProperties.Name="Open Settings"/>
      </StackPanel>
    </Grid>
  </Border>

  <Panel Grid.Row="1" x:Name="ScaleContent">

    <!-- ============ HOME ============ -->
    <DockPanel x:Name="HomeView" Margin="28,22">
      <ScrollViewer>
        <StackPanel Spacing="30" MaxWidth="1120" HorizontalAlignment="Stretch">

          <Border Classes="homepanel">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="section" Text="Start a profile" VerticalAlignment="Center"/>
                <TextBlock Text="Build, open, or find a setup" Classes="secondary"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <WrapPanel x:Name="StartCards">
                <Button x:Name="HomeNewButton" Classes="homeaction featured"
                        AutomationProperties.Name="Create a new profile from the factory default template">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconAdd}"/><TextBlock Text="New profile" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeOpenButton" Classes="homeaction"
                        AutomationProperties.Name="Open a profile CSV file from your computer">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconFolder}"/><TextBlock Text="Open a file" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeTemplateButton" Classes="homeaction"
                        AutomationProperties.Name="Start a new profile from one of your saved templates">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconTemplate}"/><TextBlock Text="Use template" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <!-- Off for this release. See AgentFeature: one switch, read here
                     at parse time so the card is never in the layout at all. -->
                <Button x:Name="HomeAgentButton" Classes="homeaction"
                        IsVisible="{x:Static app:AgentFeature.Enabled}"
                        AutomationProperties.Name="Name a game and have a profile built for it from the profiles you already have">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconSparkles}"/><TextBlock Text="Set up a game" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeCommunityButton" Classes="homeaction"
                        AutomationProperties.Name="Browse the community list of shared game profiles and import one">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconCommunity}"/><TextBlock Text="Community profiles" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeHelpButton" Classes="homeaction"
                        AutomationProperties.Name="Open the quick guide that explains profiles, outputs, functions, and inputs">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconHelp}"/><TextBlock Text="How it works" HorizontalAlignment="Center"/></StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock x:Name="HomeStatusText" FontSize="{DynamicResource BodySize}" Classes="error"
                         TextWrapping="Wrap" MaxWidth="760" IsVisible="False"
                         AutomationProperties.LiveSetting="Assertive"/>
              <StackPanel x:Name="RescuePanel" Orientation="Horizontal" Spacing="10" IsVisible="False">
                <Button x:Name="RescueOpenButton" Content="Open recovered work" Classes="primary"
                        AutomationProperties.Name="Open the profile that was recovered after the last crash or force quit"/>
                <Button x:Name="RescueDismissButton" Content="Dismiss"
                        AutomationProperties.Name="Discard the recovered work permanently"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="homepanel">
            <StackPanel Spacing="12">
              <!-- Heading, then the action for it, side by side. Pinned to the
                   far right the button sat 700px from the words it belonged to
                   and read as unrelated furniture. -->
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Classes="section" Text="On your QuadStick" VerticalAlignment="Center"/>
                <Button x:Name="HomeDeviceFilesButton" VerticalAlignment="Center" Classes="quiet"
                        FontSize="{DynamicResource SmallSize}"
                        AutomationProperties.Name="Manage the profile files on your QuadStick: copy, delete, and see the file selection order">
                  <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconFiles}"/><TextBlock Text="Manage files"/></StackPanel>
                </Button>
              </StackPanel>
              <TextBlock x:Name="DeviceEmptyText" FontSize="{DynamicResource BodySize}" Classes="secondary"
                         Text="Plug in your QuadStick to see its profiles. If the drive is hidden, turn off controller emulation and reconnect it."
                         TextWrapping="Wrap"/>
              <StackPanel x:Name="DeviceCards" Spacing="6"/>
            </StackPanel>
          </Border>

          <Border Classes="homepanel">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="Your profiles"/>
              <StackPanel x:Name="LibraryEmptyPanel" Spacing="10">
                <TextBlock FontSize="{DynamicResource BodySize}" Classes="secondary"
                           Text="Profiles you save will show up here."/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="LibraryEmptyNewButton" AutomationProperties.Name="Create a new profile from the factory default template">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconAdd}"/><TextBlock Text="New profile"/></StackPanel>
                  </Button>
                  <Button x:Name="LibraryEmptyOpenButton" AutomationProperties.Name="Open a profile CSV file from your computer">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconFolder}"/><TextBlock Text="Open a file"/></StackPanel>
                  </Button>
                  <Button x:Name="LibraryEmptyImportButton" AutomationProperties.Name="Import the profile from the pasted Google Sheets link">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconLink}"/><TextBlock Text="Import from Sheets"/></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
              <WrapPanel x:Name="LibraryCards"/>
            </StackPanel>
          </Border>

          <Border Classes="homepanel">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Classes="section" Text="Import from Sheets" VerticalAlignment="Center"/>
                <!-- Content, colour, and action are set per state in RefreshDriveButton. -->
                <Button x:Name="HomeDriveButton" IsVisible="False" VerticalAlignment="Center"
                        FontSize="{DynamicResource SmallSize}"/>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                <TextBox x:Name="SheetsUrlBox" Grid.Column="0" Width="560"
                         Watermark="Paste a Google Sheets profile link"
                         AutomationProperties.Name="Google Sheets profile link"/>
                <Button x:Name="ImportButton" Grid.Column="1" Margin="10,0,0,0"
                        Classes="primary" MinWidth="130"
                        AutomationProperties.Name="Import the profile from the pasted Google Sheets link">
                  <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconLink}"/><TextBlock Text="Import"/></StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Files opened from elsewhere on the computer. Hidden until there
               is one, so a first run stays as simple as it is today. -->
          <StackPanel x:Name="RecentSection" IsVisible="False">
            <Border Classes="homepanel">
              <StackPanel Spacing="12">
                <TextBlock Classes="section" Text="Opened from your computer"/>
                <WrapPanel x:Name="RecentCards"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock x:Name="HomeVersionText" Classes="secondary" Margin="2,0,0,4"
                     FontSize="{DynamicResource SmallSize}"/>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ============ EDITOR ============ -->
    <DockPanel x:Name="EditorView" IsVisible="False">

      <!-- Row 1: back, which profile, then what to do with it.
           A WrapPanel, not a Grid. Interface scale divides the width the layout
           actually gets (ScaleContent.Width = window / scale), so a 1180px
           window at 200% lays out in 590 logical px. A row that cannot wrap
           does not shrink there, it pushes its last buttons off the edge of
           the window where nobody can reach them at all. Wrapping keeps every
           command on screen and keeps its label, which matters more here than
           a tidy line: this app is driven by mouth joysticks and switches, so
           icon-only toolbars and side-scrolling are both hostile. -->
      <Border DockPanel.Dock="Top" Classes="editorchrome">
        <StackPanel>
      <WrapPanel Classes="toolbar" Margin="0,0,0,4">
        <TextBlock Text="Profile" VerticalAlignment="Center" Classes="secondary"/>
        <TextBox x:Name="FileNameBox" Width="230" FontSize="{DynamicResource SubheadSize}" FontWeight="Bold"
                 VerticalAlignment="Center"
                 AutomationProperties.Name="Profile name. Edit to rename; .csv is added for you">
          <TextBox.InnerRightContent>
            <TextBlock Text=".csv" Classes="secondary" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="{DynamicResource SubheadSize}"/>
          </TextBox.InnerRightContent>
        </TextBox>
        <!-- Off for this release. See AgentFeature. -->
        <Button x:Name="AgentButton" Classes="quiet" Content="Ask for a change"
                IsVisible="{x:Static app:AgentFeature.Enabled}"
                AutomationProperties.Name="Describe a change in plain words and have it made to this profile. Nothing is changed until you approve it."/>
        <Button x:Name="ShareButton" Classes="quiet" Content="Share"
                AutomationProperties.Name="Share this profile as a Google Sheet"/>
        <!-- Which profile | what to do with it. The gap used to do this job,
             before the actions stopped being pinned to the right edge. -->
        <Border Width="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="6,4"/>
        <Button x:Name="SaveButton" Content="Save"
                AutomationProperties.Name="Save this profile. Shortcut Control S"/>
        <Button x:Name="UndoButton" Content="Undo"
                AutomationProperties.Name="Undo the last change. Shortcut Control Z"/>
        <Button x:Name="SaveTemplateButton" Content="Save as template"
                AutomationProperties.Name="Save this profile as a reusable template you can start new profiles from"/>
        <Button x:Name="InstallButton" Content="Install to QuadStick" Classes="primary"
                AutomationProperties.Name="Install this profile onto a connected QuadStick. Shortcut Control I"/>
        <Button x:Name="HelpButton" Content="Help"
                AutomationProperties.Name="Open the quick guide. Shortcut Control H or F1"/>
      </WrapPanel>

      <ContentControl x:Name="StatusHost" Margin="0,0,0,4"/>

      <!-- Row 2: which mode (with a plain-language explainer), how to view it,
           add a row, what is still free. Wraps, for the same reason as row 1. -->
      <WrapPanel Classes="toolbar" Margin="0,0,0,-6">
        <TextBlock Text="Mode" VerticalAlignment="Center" FontSize="{DynamicResource BodySize}"/>
        <ComboBox x:Name="SheetPicker" MinWidth="180"
                  AutomationProperties.Name="Select which mode to edit"/>
        <Button x:Name="ModeHelpButton" Classes="icon" Content="?"
                AutomationProperties.Name="What is a mode, and why is there only one?"/>
        <Button x:Name="ModesButton" Classes="quiet" Content="Modes..."
                AutomationProperties.Name="Add, rename, reorder and delete modes"/>
        <Border Width="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="6,4"/>
        <!-- These three are one mutually-exclusive choice, so they sit in a
             shared track like a rocker switch bank rather than as loose,
             independent buttons. -->
        <Border Classes="switchtrack">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="DeviceViewButton" Classes="switchkey" Content="Device view"
                    AutomationProperties.Name="Show the mappings on a picture of the QuadStick. Shortcut Control D toggles this"/>
            <Button x:Name="RailViewButton" Classes="switchkey" Content="Parts list"
                    AutomationProperties.Name="Show the parts as a simple list you arrow through, with the same editor on the right"/>
            <Button x:Name="ListViewButton" Classes="switchkey" Content="List view"
                    AutomationProperties.Name="Show the mappings as a list of rows. Shortcut Control D toggles this"/>
          </StackPanel>
        </Border>
        <Border Width="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="6,4"/>
        <Button x:Name="AddRowButton" Content="+ Add row"
                AutomationProperties.Name="Add a new binding row to this mode"/>
        <!-- Content is set in code so the button can carry the live count. -->
        <Button x:Name="UnusedButton" Classes="quiet"
                AutomationProperties.Name="List the inputs this mode has not used yet"/>
      </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Problems: collapsed to a single bar by default so it never eats the
           editor; the full list expands above the bar on demand. When the file
           is clean it disappears entirely, since the top status line already
           says there are no problems. -->
      <StackPanel x:Name="ProblemsDock" DockPanel.Dock="Bottom" Margin="16,10,16,16">
        <Border x:Name="ProblemsListBorder" IsVisible="False" Height="150" Margin="0,0,0,8"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}">
          <ListBox x:Name="IssuesList" FontSize="{DynamicResource SmallSize}" Background="Transparent"
                   AutomationProperties.Name="List of validation problems. Select one to copy it."/>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="ProblemsToggle" Grid.Column="0" Classes="quiet" HorizontalContentAlignment="Left"
                  AutomationProperties.Name="Show or hide the list of problems"/>
          <Button x:Name="FixFirstButton" Grid.Column="2" Content="Fix first problem" Classes="quiet"
                  AutomationProperties.Name="Jump to and focus the first error in the Problems list"/>
        </Grid>
      </StackPanel>

      <Panel Margin="16,14,16,0">
        <Border x:Name="GridContainer" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource PanelRadiusCorner}" Padding="12">
          <!-- Named so a deleted row's ghost snapshot can float over the list
               while it fades out; clipped so it never escapes the plate. -->
          <Panel x:Name="ListOverlay" ClipToBounds="True">
            <!-- Disabled, and that is what makes the row fit: with sideways
                 scrolling on, a row is offered infinite width and every
                 proportional column falls back to its content's size. Off, the
                 row gets exactly the window's width and shares it out. Panning
                 sideways to reach a column is not something a mouth stick can
                 reasonably do, so the row wraps and grows taller instead. -->
            <ScrollViewer x:Name="GridScroll" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>
            <!-- Appears only while rows are selected: how many, and what can
                 be done to them. Floats over the bottom-left corner so
                 selecting never pushes the rows down. -->
            <Border x:Name="SelectionBar" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    CornerRadius="6" Padding="10,6" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="SelectionMoveButton" Content="Move" Classes="quiet"
                        AutomationProperties.Name="Move the selected rows to the top or bottom"/>
                <Button x:Name="SelectionDeleteButton" Content="Delete" Classes="danger"
                        AutomationProperties.Name="Delete the selected rows"/>
                <Button x:Name="SelectionClearButton" Content="Clear" Classes="quiet"
                        AutomationProperties.Name="Clear the selection"/>
              </StackPanel>
            </Border>
          </Panel>
        </Border>
        <Border x:Name="DeviceContainer" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource PanelRadiusCorner}" IsVisible="False">
          <DockPanel>
            <Border x:Name="DeviceHeaderRow" DockPanel.Dock="Top" Padding="14,10"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
              <!-- Wraps for the same reason as the rows above: a fixed Grid here
                   pushed the model picker and the card toggle off the edge. -->
              <WrapPanel Classes="toolbar">
                <ContentControl x:Name="DeviceHeaderStatus" VerticalAlignment="Center"/>
                <TextBlock x:Name="DeviceHeaderMode" Classes="secondary"
                           VerticalAlignment="Center" FontSize="{DynamicResource SmallSize}"/>
                <!-- What the device's own five lights show for this mode. The
                     lights are drawn on the photo too; this is the same thing
                     in words, for anyone the colours do not reach. -->
                <TextBlock x:Name="DeviceHeaderLights" Classes="secondary"
                           VerticalAlignment="Center" FontSize="{DynamicResource SmallSize}"/>
                <ComboBox x:Name="ModelPicker" MinWidth="180"
                          AutomationProperties.Name="Which QuadStick model you have"/>
                <Button x:Name="DeviceHelpButton" Classes="icon" Content="?"
                        AutomationProperties.Name="How device view works, and which parts your model has"/>
                <Button x:Name="LabelStyleButton" Classes="quiet"
                        AutomationProperties.Name="Switch the words used in device view between plain English and the raw list-view names"/>
                <Button x:Name="CardViewButton" Classes="quiet"/>
              </WrapPanel>
            </Border>
            <!-- The device diagram owns the larger, left-hand share of the
                 editor so its parts sit at a comfortable size. The mappings
                 panel on the right stays readable through its minimum width. -->
            <Grid ColumnDefinitions="1.2*,1*">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DeviceCanvas" Margin="14"/>
              </ScrollViewer>
              <Border Grid.Column="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                      BorderThickness="1,0,0,0" Padding="18" MinWidth="340">
                <Panel x:Name="ZoneOverlay" ClipToBounds="True">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ZoneDetailPanel" Spacing="14"/>
                  </ScrollViewer>
                  <!-- Same job as SelectionBar in list view, for card selections.
                       Lives outside the rebuilt panel so a selection click never
                       destroys the control being dragged, and floats so
                       selecting never pushes the cards down. -->
                  <Border x:Name="DeviceSelectionBar" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          CornerRadius="6" Padding="10,6" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock x:Name="DeviceSelectionCount" VerticalAlignment="Center" FontWeight="Bold"/>
                      <Button x:Name="DeviceSelectionMoveButton" Content="Move" Classes="quiet"
                              AutomationProperties.Name="Move the selected mappings to the top or bottom"/>
                      <Button x:Name="DeviceSelectionDeleteButton" Content="Delete" Classes="danger"
                              AutomationProperties.Name="Delete the selected mappings"/>
                      <Button x:Name="DeviceSelectionClearButton" Content="Clear" Classes="quiet"
                              AutomationProperties.Name="Clear the selection"/>
                    </StackPanel>
                  </Border>
                </Panel>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </Panel>

    </DockPanel>
  </Panel>
  </Grid>
  </LayoutTransformControl>
  </Panel>
</Window>
