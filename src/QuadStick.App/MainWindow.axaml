<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuadStick.App"
        x:Class="QuadStick.App.MainWindow"
        Title="Quadstick: Config Manager (unofficial)"
        Icon="avares://QuadStickConfigManager/Assets/AppIcon.png"
        Width="1180" Height="920" MinWidth="760" MinHeight="560">
  <Panel x:Name="RootHost">
  <LayoutTransformControl x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
  <Grid x:Name="RootPanel" RowDefinitions="Auto,*">
  <!-- Persistent application chrome. Home and Editor are pages inside QCM,
       not separate utilities with unrelated headers. The major destinations
       stay in the same place while the content below changes. -->
  <Border Grid.Row="0" Classes="appchrome">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!-- The mark is the way home. It is the biggest, most predictable target
           in the window and it is in the corner every other app puts one, so
           anyone aiming with a mouth stick or a head mouse can always get back
           without hunting the nav row. -->
      <Button x:Name="ShellBrandButton" Grid.Column="0" Classes="shellbrandbutton"
              VerticalAlignment="Center"
              AutomationProperties.Name="{x:Static app:Strings.Shell_QuadStickConfigManagerGoTo}"
              ToolTip.Tip="{x:Static app:Strings.Shell_GoToHome}">
        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="9" ClipToBounds="True">
            <Image Source="avares://QuadStickConfigManager/Assets/AppIcon.png" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="QCM" Classes="shellbrand"/>
            <TextBlock x:Name="ShellBrandCaption" Text="QuadStick Config Manager" Classes="shellcaption"/>
          </StackPanel>
        </StackPanel>
      </Button>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="ShellHomeButton" Classes="shellnav active"
                ToolTip.Tip="{x:Static app:Strings.Shell_Home}"
                AutomationProperties.Name="{x:Static app:Strings.Shell_Home}">
          <PathIcon Data="{DynamicResource IconHome}"/>
        </Button>
        <!-- Three destinations, no commands. New and Open were commands sitting
             in a row of places, and both already live on Home where a profile
             gets started. -->
        <Button x:Name="ShellDeviceButton" Classes="shellnav"
                ToolTip.Tip="{x:Static app:Strings.Shell_ManageFilesOnYourQuadStick}"
                AutomationProperties.Name="{x:Static app:Strings.Shell_ManageFilesOnYourQuadStick}">
          <PathIcon Data="{DynamicResource IconDevice}"/>
        </Button>
        <Button x:Name="ShellCommunityButton" Classes="shellnav"
                ToolTip.Tip="{x:Static app:Strings.Shell_BrowseCommunityProfiles}"
                AutomationProperties.Name="{x:Static app:Strings.Shell_BrowseCommunityProfiles}">
          <PathIcon Data="{DynamicResource IconCommunity}"/>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="AppearancePicker" MinWidth="112"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_AppearanceChooseSystemLightOr}"/>
        <!-- Deliberately the largest control in the chrome. It is the one thing
             people go looking for when the interface itself is the problem
             (scale, theme, contrast). -->
        <Button x:Name="SettingsButton" Classes="shellutility"
                ToolTip.Tip="{x:Static app:Strings.Shell_Settings}"
                AutomationProperties.Name="{x:Static app:Strings.Shell_OpenSettings}">
          <PathIcon Data="{DynamicResource IconSettings}"/>
        </Button>

      </StackPanel>
    </Grid>
  </Border>

  <Panel Grid.Row="1" x:Name="ScaleContent">

    <!-- ============ HOME ============ -->
    <DockPanel x:Name="HomeView" Margin="28,22">
      <ScrollViewer>
        <!-- Centred, not left-hugging. On a wide window the whole page used to
             sit against the left edge with a third of the screen empty beside
             it. The column keeps its measure; it is the column that centres,
             not the text inside it, because centred body copy is harder to
             read and harder to scan down. -->
        <StackPanel Spacing="30" MaxWidth="1120" HorizontalAlignment="Center">


          <Border Classes="homepanel">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="section" Text="{x:Static app:Strings.Shell_StartAProfile}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static app:Strings.Shell_BuildOpenOrFindA}" Classes="secondary"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <WrapPanel x:Name="StartCards" HorizontalAlignment="Center">
                <Button x:Name="HomeNewButton" Classes="homeaction featured"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_CreateANewProfileFrom}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconAdd}"/><TextBlock Text="{x:Static app:Strings.Shell_NewProfile}" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeOpenButton" Classes="homeaction"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_OpenAProfileCSVFile}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconFolder}"/><TextBlock Text="{x:Static app:Strings.Shell_OpenAFile}" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeTemplateButton" Classes="homeaction"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_StartANewProfileFrom}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconTemplate}"/><TextBlock Text="{x:Static app:Strings.Shell_UseTemplate}" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <!-- Off for this release. See AgentFeature: one switch, read here
                     at parse time so the card is never in the layout at all. -->
                <Button x:Name="HomeAgentButton" Classes="homeaction"
                        IsVisible="{x:Static app:AgentFeature.Enabled}"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_NameAGameAndHave}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconSparkles}"/><TextBlock Text="{x:Static app:Strings.Shell_SetUpAGame}" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeCommunityButton" Classes="homeaction"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_BrowseTheCommunityListOf}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconCommunity}"/><TextBlock Text="{x:Static app:Strings.Shell_CommunityProfiles}" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="HomeHelpButton" Classes="homeaction"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_OpenTheQuickGuideThat}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center"><PathIcon HorizontalAlignment="Center" Data="{DynamicResource IconHelp}"/><TextBlock Text="{x:Static app:Strings.Shell_HowItWorks}" HorizontalAlignment="Center"/></StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock x:Name="HomeStatusText" FontSize="{DynamicResource BodySize}" Classes="error"
                         TextWrapping="Wrap" MaxWidth="760" IsVisible="False"
                         AutomationProperties.LiveSetting="Assertive"/>
              <StackPanel x:Name="RescuePanel" Orientation="Horizontal" Spacing="10" IsVisible="False">
                <Button x:Name="RescueOpenButton" Content="{x:Static app:Strings.Shell_OpenRecoveredWork}" Classes="primary"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_OpenTheProfileThatWas}"/>
                <Button x:Name="RescueDismissButton" Content="{x:Static app:Strings.Shell_Dismiss}"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_DiscardTheRecoveredWorkPermanently}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="homepanel">
            <StackPanel Spacing="12">
              <!-- Heading, then the action for it, side by side. Pinned to the
                   far right the button sat 700px from the words it belonged to
                   and read as unrelated furniture. -->
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Classes="section" Text="{x:Static app:Strings.Shell_OnYourQuadStick}" VerticalAlignment="Center"/>
                <Button x:Name="HomeDeviceFilesButton" VerticalAlignment="Center" Classes="quiet"
                        FontSize="{DynamicResource SmallSize}"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_ManageTheProfileFilesOn}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconFiles}"/><TextBlock Text="{x:Static app:Strings.Shell_ManageFiles}"/></StackPanel>
                </Button>
              </StackPanel>
              <TextBlock x:Name="DeviceEmptyText" FontSize="{DynamicResource BodySize}" Classes="secondary"
                         Text="{x:Static app:Strings.Shell_PlugInYourQuadStickTo}"
                         TextWrapping="Wrap"/>
              <StackPanel x:Name="DeviceCards" Spacing="6"/>
            </StackPanel>
          </Border>

          <Border Classes="homepanel">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="{x:Static app:Strings.Shell_YourProfiles}"/>
              <StackPanel x:Name="LibraryEmptyPanel" Spacing="10">
                <TextBlock FontSize="{DynamicResource BodySize}" Classes="secondary"
                           Text="{x:Static app:Strings.Shell_ProfilesYouSaveWillShow}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="LibraryEmptyNewButton" AutomationProperties.Name="{x:Static app:Strings.Shell_CreateANewProfileFrom}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconAdd}"/><TextBlock Text="{x:Static app:Strings.Shell_NewProfile}"/></StackPanel>
                  </Button>
                  <Button x:Name="LibraryEmptyOpenButton" AutomationProperties.Name="{x:Static app:Strings.Shell_OpenAProfileCSVFile}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconFolder}"/><TextBlock Text="{x:Static app:Strings.Shell_OpenAFile}"/></StackPanel>
                  </Button>
                  <Button x:Name="LibraryEmptyImportButton" AutomationProperties.Name="{x:Static app:Strings.Shell_ImportTheProfileFromThe}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconLink}"/><TextBlock Text="{x:Static app:Strings.Shell_ImportFromSheets}"/></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
              <WrapPanel x:Name="LibraryCards"/>
            </StackPanel>
          </Border>

          <Border Classes="homepanel">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Classes="section" Text="{x:Static app:Strings.Shell_ImportFromSheets}" VerticalAlignment="Center"/>
                <!-- Content, colour, and action are set per state in RefreshDriveButton. -->
                <Button x:Name="HomeDriveButton" IsVisible="False" VerticalAlignment="Center"
                        FontSize="{DynamicResource SmallSize}"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                <TextBox x:Name="SheetsUrlBox" Grid.Column="0" MinWidth="420"
                         Watermark="{x:Static app:Strings.Shell_PasteAGoogleSheetsProfile}"
                         AutomationProperties.Name="{x:Static app:Strings.Shell_GoogleSheetsProfileLink}"/>
                <Button x:Name="ImportButton" Grid.Column="1" Margin="10,0,0,0"
                        Classes="primary" MinWidth="130"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_ImportTheProfileFromThe}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="{DynamicResource IconLink}"/><TextBlock Text="{x:Static app:Strings.Shell_Import}"/></StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Files opened from elsewhere on the computer. Hidden until there
               is one, so a first run stays as simple as it is today. -->
          <StackPanel x:Name="RecentSection" IsVisible="False">
            <Border Classes="homepanel">
              <StackPanel Spacing="12">
                <TextBlock Classes="section" Text="{x:Static app:Strings.Shell_OpenedFromYourComputer}"/>
                <WrapPanel x:Name="RecentCards"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock x:Name="HomeVersionText" Classes="secondary" Margin="2,0,0,4"
                     FontSize="{DynamicResource SmallSize}"/>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ============ EDITOR ============ -->
    <DockPanel x:Name="EditorView" IsVisible="False">

      <!-- The command band. Wrapping, not a Grid: interface scale divides the
           width the layout actually gets (ScaleContent.Width = window / scale),
           so a 1180px window at 200% lays out in 590 logical px. A row that
           cannot wrap does not shrink there, it pushes its last buttons off the
           edge of the window where nobody can reach them at all. Wrapping keeps
           every command on screen and keeps its label, which matters more here
           than a tidy line: this app is driven by mouth joysticks and switches,
           so icon-only toolbars and side-scrolling are both hostile. -->
      <Border DockPanel.Dock="Top" Classes="editorchrome">
        <StackPanel>
      <!-- Which profile on the left, where it is going on the right. Install is
           the destination, so it is pinned to the far edge with Save beside it
           and nothing else can push either of them off: a DockPanel, not a
           WrapPanel item, because a wrapped Install lands in the middle of a
           line and stops reading as the end of the job. Everything else stays
           in a WrapPanel for the reason above. -->
      <DockPanel Margin="0,0,0,4">
        <Button x:Name="InstallButton" DockPanel.Dock="Right" Classes="primary install" Margin="10,0,0,6"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Static app:Strings.Shell_InstallThisProfileOntoA}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{DynamicResource IconInstall}"/>
            <TextBlock Text="{x:Static app:Strings.Shell_InstallToQuadStick}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="SaveButton" DockPanel.Dock="Right" Classes="command" Margin="10,0,0,6"
                VerticalAlignment="Top"
                ToolTip.Tip="{x:Static app:Strings.Shell_SaveCtrlS}"
                AutomationProperties.Name="{x:Static app:Strings.Shell_SaveThisProfileShortcutControl}">
          <PathIcon Data="{DynamicResource IconSave}"/>
        </Button>
        <WrapPanel Classes="toolbar">
          <TextBlock Text="{x:Static app:Strings.Shell_Profile}" VerticalAlignment="Center" Classes="secondary"/>
          <TextBox x:Name="FileNameBox" Width="230" FontSize="{DynamicResource SubheadSize}" FontWeight="Bold"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="{x:Static app:Strings.Shell_ProfileNameEditToRename}">
            <TextBox.InnerRightContent>
              <TextBlock Text="{x:Static app:Strings.Shell_Csv}" Classes="secondary" VerticalAlignment="Center" Margin="0,0,8,0"
                         FontSize="{DynamicResource SubheadSize}"/>
            </TextBox.InnerRightContent>
          </TextBox>
          <!-- Off for this release. See AgentFeature. -->
          <Button x:Name="AgentButton" Classes="quiet" Content="{x:Static app:Strings.Shell_AskForAChange}"
                  IsVisible="{x:Static app:AgentFeature.Enabled}"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_DescribeAChangeInPlain}"/>
          <!-- Save, Undo, Share and Help are the four everyone already knows by
               shape. As words they were four equal-weight grey rectangles and the
               one destination that matters, Install, had to shout over them.
               AutomationProperties.Name still carries the full sentence, and each
               one has a tooltip, so nothing is lost to a screen reader or to
               somebody who does not recognise the glyph. -->
          <Button x:Name="ShareButton" Classes="command quiet" ToolTip.Tip="{x:Static app:Strings.Shell_ShareAsAGoogleSheet}"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_ShareThisProfileAsA}">
            <PathIcon Data="{DynamicResource IconShare}"/>
          </Button>
          <!-- Which profile | what to do with it. The gap on the left of a
               separator is the previous item's own 10px trailing margin, so the
               separator only carries the gap on its right: matching numbers here
               made the left side 16 and the right side 6. -->
          <Border Width="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="4,8,14,8"/>
          <Button x:Name="UndoButton" Classes="command" ToolTip.Tip="{x:Static app:Strings.Shell_UndoCtrlZ}"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_UndoTheLastChangeShortcut}">
            <PathIcon Data="{DynamicResource IconUndo}"/>
          </Button>
          <Button x:Name="SaveTemplateButton" Classes="command quiet" ToolTip.Tip="{x:Static app:Strings.Shell_SaveAsATemplate}"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_SaveThisProfileAsA}">
            <PathIcon Data="{DynamicResource IconTemplate}"/>
          </Button>
          <Button x:Name="HelpButton" Classes="command quiet" ToolTip.Tip="{x:Static app:Strings.Shell_HowItWorksF1}"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_OpenTheQuickGuideShortcut}">
            <PathIcon Data="{DynamicResource IconHelp}"/>
          </Button>
        </WrapPanel>
      </DockPanel>

      <ContentControl x:Name="StatusHost" Margin="0,0,0,4"/>

      <!-- Row 2: adding a row, which only Rows view can do. Which mode,
           which view, the words and which QuadStick all used to sit here as a
           second line of loose buttons; they live in the panel down the left
           side now, where they read as a place instead of a row of controls
           and where they cost the device diagram nothing. -->
      <WrapPanel x:Name="RowCommandBar" Classes="toolbar" Margin="0,0,0,-6">
        <!-- Rows view only. Device view adds a mapping by pressing the plus on
             the part you are looking at, which says where the row landed; the
             same button up here made a row appear somewhere off screen. -->
        <Button x:Name="AddRowButton" Content="{x:Static app:Strings.Shell_AddRow}"
                AutomationProperties.Name="{x:Static app:Strings.Shell_AddANewBindingRow}"/>
        <!-- Off for this release: the count was worth less than the width it
             took, and every part now says what is free on it in the panel next
             to the device. The list itself still works and is still tested.
             Content and name are kept live below so turning it back on is one
             line in RefreshEditor. -->
        <Button x:Name="UnusedButton" Classes="quiet" IsVisible="False"
                AutomationProperties.Name="{x:Static app:Strings.Shell_ListTheInputsThisMode}"/>
      </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Problems: collapsed to a single bar by default so it never eats the
           editor; the full list expands above the bar on demand. When the file
           is clean it disappears entirely, since the top status line already
           says there are no problems. -->
      <StackPanel x:Name="ProblemsDock" DockPanel.Dock="Bottom" Margin="16,0,16,14">
        <Border x:Name="ProblemsListBorder" IsVisible="False" Height="150" Margin="0,0,0,8"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}">
          <ListBox x:Name="IssuesList" FontSize="{DynamicResource SmallSize}" Background="Transparent"
                   AutomationProperties.Name="{x:Static app:Strings.Shell_ListOfValidationProblemsSelect}"/>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="ProblemsToggle" Grid.Column="0" Classes="quiet" HorizontalContentAlignment="Left"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_ShowOrHideTheList}"/>
          <Button x:Name="FixFirstButton" Grid.Column="2" Content="{x:Static app:Strings.Shell_FixFirstProblem}" Classes="quiet"
                  AutomationProperties.Name="{x:Static app:Strings.Shell_JumpToAndFocusThe}"/>
        </Grid>
      </StackPanel>

      <!-- The panel down the left side: where you are in the profile, and
           what the window beside it is showing. Which mode, which view, which
           QuadStick and the parts that have no place on the picture were all
           loose controls in two bands across the top. Together they are one
           place, and the diagram gets the height they were taking. -->
      <!-- One frame for the whole editor workspace. The sidebar and the active
           editor are still separate columns because they have different jobs,
           but their shared frame makes the profile feel like one place. -->
      <Border x:Name="EditorWorkspace" Margin="16,14"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource PanelRadiusCorner}"
              ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,*">
        <Border x:Name="EditorSidebar" Grid.Column="0"
                Width="{DynamicResource SidebarWidth}"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,14">

          <!-- Pinned to the bottom, and separated: these change how the editor
               is drawn, not what the profile says. -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <Border Height="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="0,12,0,2"/>
            <DockPanel>
              <Button x:Name="DeviceHelpButton" DockPanel.Dock="Right" Classes="icon quiet" Content="?"
                      AutomationProperties.Name="{x:Static app:Strings.Shell_HowDeviceViewWorksAnd}"/>
              <TextBlock Text="{x:Static app:Strings.Shell_View}" VerticalAlignment="Center" Classes="secondary"
                         FontSize="{DynamicResource SmallSize}"/>
            </DockPanel>
            <!-- These three are one mutually-exclusive choice, so they sit in a
                 shared track like a rocker switch bank rather than as loose,
                 independent buttons. Each key shows what it will give you: the
                 device, the parts of it, or the sheet the file actually is. The
                 word stays under the picture, because a glyph alone is a guess.
                 Equal columns, not a stack: in a fixed-width panel the three
                 keys have to share the width rather than take what their words
                 happen to need. -->
            <Border Classes="switchtrack">
              <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="DeviceViewButton" Classes="switchkey viewkey"
                        ToolTip.Tip="{x:Static app:Strings.Shell_SeeTheMappingsOnA}"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_ShowTheMappingsOnA}">
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{DynamicResource IconViewDevice}"/>
                    <TextBlock Text="{x:Static app:Strings.Shell_Device}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="RailViewButton" Grid.Column="1" Classes="switchkey viewkey"
                        ToolTip.Tip="{x:Static app:Strings.Shell_StepThroughThePartsOne}"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_ShowThePartsAsA}">
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{DynamicResource IconViewRail}"/>
                    <TextBlock Text="{x:Static app:Strings.Shell_Parts}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="ListViewButton" Grid.Column="2" Classes="switchkey viewkey"
                        ToolTip.Tip="{x:Static app:Strings.Shell_SeeTheRowsTheWay}"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_ShowTheMappingsAsA}">
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{DynamicResource IconViewSheet}"/>
                    <TextBlock Text="{x:Static app:Strings.Shell_Rows}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <Button x:Name="LabelStyleButton" Classes="quiet"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    FontSize="{DynamicResource SmallSize}"
                    AutomationProperties.Name="{x:Static app:Strings.Shell_SwitchTheWordsUsedIn}"/>
            <Button x:Name="CardViewButton" Classes="quiet"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    FontSize="{DynamicResource SmallSize}"/>
          </StackPanel>

          <!-- The file's own contents: which mode, which QuadStick, which
               parts. Scrolls as one, with the modes list capped inside it so a
               profile with nine modes cannot push the parts out of reach. -->
          <!-- The bar stays drawn rather than fading out: this panel is taller
               than the window on any full profile, and a scrollbar that only
               appears once you are already scrolling tells you nothing. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        AllowAutoHide="False">
            <StackPanel Spacing="8">
              <!-- Modes are the spine of a profile, so they are the top of the
                   panel and adding one is the plus at the end of their own
                   heading. The question mark comes first because it reads as
                   part of the word it explains. -->
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <Button x:Name="ModeHelpButton" Classes="icon quiet" Content="?"
                          ToolTip.Tip="{x:Static app:Strings.Shell_WhatIsAMode}"
                          AutomationProperties.Name="{x:Static app:Strings.Shell_WhatIsAModeAnd}"/>
                  <Button x:Name="AddModeButton" Classes="icon primary"
                          ToolTip.Tip="{x:Static app:Strings.Modes_AddAMode}"
                          AutomationProperties.Name="{x:Static app:Strings.Modes_AddAMode}">
                    <PathIcon Data="{DynamicResource IconAdd}"/>
                  </Button>
                </StackPanel>
                <TextBlock Text="{x:Static app:Strings.Modes_Modes}" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="{DynamicResource BodySize}"/>
              </DockPanel>
              <!-- One row per sheet, numbered the way the device numbers them.
                   Built in RefreshEditor, because a mode can be added, renamed
                   or deleted from three other places. -->
              <!-- Four rows and a slice of the fifth, so a long list says it is
                   long instead of ending on a clean edge. -->
              <ScrollViewer MaxHeight="194" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
                <StackPanel x:Name="ModeList" Spacing="4"/>
              </ScrollViewer>
              <!-- "Modes..." named a dialog, not a job. Everything people come
                   here to do (rename, reorder, delete) is editing the set. -->
              <Button x:Name="ModesButton" Classes="quiet"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      FontSize="{DynamicResource SmallSize}"
                      ToolTip.Tip="{x:Static app:Strings.Shell_AddRenameReorderAndDelete}"
                      AutomationProperties.Name="{x:Static app:Strings.Shell_EditModesAddRenameReorder}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Data="{DynamicResource IconTemplate}"/>
                  <TextBlock Text="{x:Static app:Strings.Shell_EditModes}"/>
                </StackPanel>
              </Button>

              <Border Height="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="0,8,0,2"/>
              <TextBlock Text="{x:Static app:Strings.Shell_Configuration}"
                         FontWeight="Bold" FontSize="{DynamicResource BodySize}"/>
              <!-- Which QuadStick, whether one is plugged in, and which mode is
                   on screen: the three facts the picture is drawn from. -->
              <ComboBox x:Name="ModelPicker" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_WhichQuadStickModelYouHave}"/>
              <ContentControl x:Name="DeviceHeaderStatus" HorizontalAlignment="Left"/>
              <!-- The mode, and what the device's own five lights show for it.
                   The lights are drawn on the photo too; this is the same thing
                   in words, for anyone the colours do not reach. -->
              <TextBlock x:Name="DeviceHeaderMode" Classes="secondary" TextWrapping="Wrap"
                         FontSize="{DynamicResource SmallSize}"/>
              <!-- Whole combos, switch jacks, USB devices and rows with no
                   input: real parts of the profile with nowhere to sit on the
                   photo. Under the diagram they pushed the QuadStick, the one
                   thing that view exists to show, off the top of the panel. -->
              <StackPanel x:Name="ZoneList" Spacing="6"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        </Border>

        <!-- The active editor occupies the other column in the same workspace
             frame; its own surface/border is removed so it cannot look like a
             second unrelated container. -->
        <Panel Grid.Column="1">
        <Border x:Name="GridContainer" Background="Transparent" BorderBrush="Transparent"
                BorderThickness="0" CornerRadius="0" Padding="12">
          <!-- Named so a deleted row's ghost snapshot can float over the list
               while it fades out; clipped so it never escapes the plate. -->
          <Panel x:Name="ListOverlay" ClipToBounds="True">
            <!-- Disabled, and that is what makes the row fit: with sideways
                 scrolling on, a row is offered infinite width and every
                 proportional column falls back to its content's size. Off, the
                 row gets exactly the window's width and shares it out. Panning
                 sideways to reach a column is not something a mouth stick can
                 reasonably do, so the row wraps and grows taller instead. -->
            <ScrollViewer x:Name="GridScroll" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>
            <!-- Appears only while rows are selected: how many, and what can
                 be done to them. Floats over the bottom-left corner so
                 selecting never pushes the rows down. -->
            <Border x:Name="SelectionBar" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    CornerRadius="6" Padding="10,6" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="SelectionMoveButton" Content="{x:Static app:Strings.Shell_Move}" Classes="quiet"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_MoveTheSelectedRowsTo}"/>
                <Button x:Name="SelectionDeleteButton" Content="{x:Static app:Strings.Shell_Delete}" Classes="danger"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_DeleteTheSelectedRows}"/>
                <Button x:Name="SelectionClearButton" Content="{x:Static app:Strings.Shell_Clear}" Classes="quiet"
                        AutomationProperties.Name="{x:Static app:Strings.Shell_ClearTheSelection}"/>
              </StackPanel>
            </Border>
          </Panel>
        </Border>
        <Border x:Name="DeviceContainer" Background="Transparent" BorderBrush="Transparent"
                BorderThickness="0" CornerRadius="0" IsVisible="False">
            <!-- The device diagram owns the larger, left-hand share of the
                 editor so its parts sit at a comfortable size. The mappings
                 panel on the right stays readable through its minimum width. -->
            <!-- Even halves. At 1.2 to 1 the panel on the right was 460 wide at
                 the default window size, which is under what a mapping sentence
                 needs, so every long output name arrived as "Mouse right b...".
                 The picture reads fine with the smaller half. The minimum below
                 is what is left after the side panel takes its width: at the
                 smallest window the app opens at, a floor of 340 here pushed
                 the picture off its own column. Under 470 the cards already
                 lay themselves out for a narrow panel (NarrowCards). -->
            <Grid ColumnDefinitions="1*,1*">
              <!-- Scrolls only when the space left is under the floor the
                   picture stops being readable at; above that it fits itself to
                   the room it has. See FitDeviceStage. -->
              <ScrollViewer x:Name="DeviceStageScroll" Margin="12"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DeviceCanvas"/>
              </ScrollViewer>
              <Border Grid.Column="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                      BorderThickness="1,0,0,0" Padding="18" MinWidth="280">
                <Panel x:Name="ZoneOverlay" ClipToBounds="True">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ZoneDetailPanel" Spacing="14"/>
                  </ScrollViewer>
                  <!-- Same job as SelectionBar in list view, for card selections.
                       Lives outside the rebuilt panel so a selection click never
                       destroys the control being dragged, and floats so
                       selecting never pushes the cards down. -->
                  <Border x:Name="DeviceSelectionBar" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          CornerRadius="6" Padding="10,6" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock x:Name="DeviceSelectionCount" VerticalAlignment="Center" FontWeight="Bold"/>
                      <Button x:Name="DeviceSelectionMoveButton" Content="{x:Static app:Strings.Shell_Move}" Classes="quiet"
                              AutomationProperties.Name="{x:Static app:Strings.Shell_MoveTheSelectedMappingsTo}"/>
                      <Button x:Name="DeviceSelectionDeleteButton" Content="{x:Static app:Strings.Shell_Delete}" Classes="danger"
                              AutomationProperties.Name="{x:Static app:Strings.Shell_DeleteTheSelectedMappings}"/>
                      <Button x:Name="DeviceSelectionClearButton" Content="{x:Static app:Strings.Shell_Clear}" Classes="quiet"
                              AutomationProperties.Name="{x:Static app:Strings.Shell_ClearTheSelection}"/>
                    </StackPanel>
                  </Border>
                </Panel>
              </Border>
            </Grid>
        </Border>
        </Panel>
        </Grid>
      </Border>

    </DockPanel>

    <!-- ============ DEVICE ============ -->
    <!-- Tuning the QuadStick itself, not the profiles on it. A page and not a
         dialog because it is one of the three places the app goes, and because
         a settings screen you tune while sipping needs the whole window. The
         body is built in code: the rows come from the preference catalog, so
         the layout follows the file that is actually on the device. -->
    <!-- The bar is always here and its buttons grey out, rather than the bar
         appearing on the first edit. It used to pop in, which pushed the
         settings up under the pointer mid-drag, and it was rebuilt from
         scratch on every slider tick. -->
    <DockPanel x:Name="DevicePage" IsVisible="False" Margin="28,22">
      <Border x:Name="DeviceSaveBar" DockPanel.Dock="Bottom"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource PanelRadiusCorner}"
              Margin="0,14,0,0" Padding="16,10">
        <!-- A grid, not a wrapping toolbar: the line on the left gets longer
             the moment something changes, and in a WrapPanel that pushed the
             buttons onto a second row and made the bar taller. The whole
             point of the bar is that it never changes size. -->
        <Grid x:Name="DeviceSaveBarRow" ColumnDefinitions="*,Auto"/>
      </Border>
      <!-- No ScrollViewer here on purpose. The picture of the device and the
           list of groups stay put; only the open group's settings scroll, so
           the part being tuned never leaves the screen. -->
      <Panel x:Name="DevicePageBody"/>
    </DockPanel>

    <!-- ============ COMMUNITY ============ -->
    <DockPanel x:Name="CommunityPage" IsVisible="False" Margin="28,22">
      <Panel x:Name="CommunityPageBody"/>
    </DockPanel>

    <!-- ============ SETTINGS ============ -->
    <!-- App settings (language, backup, privacy). A page in the shell, not a
         second window: one place to go back from, no nested close buttons, and
         the same keyboard path as Home and Community. -->
    <DockPanel x:Name="SettingsPage" IsVisible="False" Margin="28,22">
      <!-- The page is the window wide. The panel inside holds the fields at a
           measure somebody can read; capping the page instead left a third of
           every large screen empty and the scroll bar out in the middle of it. -->
      <Panel x:Name="SettingsPageBody"/>
    </DockPanel>

  </Panel>
  </Grid>
  </LayoutTransformControl>
  </Panel>
</Window>
