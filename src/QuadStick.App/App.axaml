<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuadStick.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://QuadStickConfigManager/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Sizes, spacing, radii and paddings all live in Style.cs, beside the
           colours in Palette.cs, and are registered at startup. Two files hold
           the whole look; nothing below states a number of its own. -->
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    </Style>
    <Style Selector="Window.dialog">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.dialogshell">
      <Setter Property="Margin" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource HairlineThickness}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelRadiusCorner}"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.dialogheader">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="18,11"/>
    </Style>
    <Style Selector="TextBlock.dialogtitle">
      <Setter Property="FontSize" Value="{DynamicResource SubheadSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <!-- A selected row is the app's own blue-grey wherever the list lives.
         Only the dialogs said so, so every list on a page picked up the
         system accent instead: one saturated blue nothing else on the screen
         used, with white text on it. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Window.dialog ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.dialog ListBoxItem">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="Window.dialog ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadiusCorner}"/>
    </Style>
    <Style Selector="Window.dialog ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Window.dialog TabItem">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,11"/>
    </Style>

    <!-- The editor's command band. Chrome and canvas were the same surface,
         so a dozen commands read as loose furniture scattered above the work
         instead of as one toolbar. Runs edge to edge under the nav bar. -->
    <Style Selector="Border.editorchrome">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="16,10,16,10"/>
    </Style>

    <!-- A plain command sits ON the band, so it cannot share the band's fill:
         in dark both were Surface and every button vanished down to its own
         hairline. The accented, quiet and rocker-switch buttons carry their own
         treatment and are left alone. -->
    <Style Selector="Border.editorchrome Button:not(.primary):not(.quiet):not(.switchkey):not(.icon)">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
    </Style>

    <!-- Persistent application frame: quieter and denser than the working
         canvas, so it stays recognizable without competing with the task. -->
    <Style Selector="Border.appchrome">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="20,11"/>
    </Style>
    <Style Selector="TextBlock.shellbrand">
      <Setter Property="FontFamily" Value="{DynamicResource BrandFont}"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>
    <Style Selector="TextBlock.shellcaption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <!-- No MinHeight of its own: 48 is the click-target floor Style.cs sets
         for mouth stick and head mouse users, and a shorter button here sits
         centred in the bar with a dead strip above and below it. -->
    <Style Selector="Button.shellnav">
      <Setter Property="Width" Value="{DynamicResource ShellNavButton}"/>
      <Setter Property="Height" Value="{DynamicResource ShellNavButton}"/>
      <Setter Property="MinWidth" Value="{DynamicResource ShellNavButton}"/>
      <Setter Property="MinHeight" Value="{DynamicResource ShellNavButton}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.shellnav PathIcon">
      <Setter Property="Width" Value="{DynamicResource ShellNavIcon}"/>
      <Setter Property="Height" Value="{DynamicResource ShellNavIcon}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.shellnav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.shellnav.active">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.shellnav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
    </Style>
    <Style Selector="Button.shellnav.active PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.shellutility">
      <Setter Property="Width" Value="{DynamicResource ShellSettingsButton}"/>
      <Setter Property="Height" Value="{DynamicResource ShellSettingsButton}"/>
      <Setter Property="MinWidth" Value="{DynamicResource ShellSettingsButton}"/>
      <Setter Property="MinHeight" Value="{DynamicResource ShellSettingsButton}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.shellutility PathIcon">
      <Setter Property="Width" Value="{DynamicResource ShellSettingsIcon}"/>
      <Setter Property="Height" Value="{DynamicResource ShellSettingsIcon}"/>
    </Style>
    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="-0.5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Press feedback is immediate. A transition here used to attach an
         animator and transform to every button in every window, making dense
         editor screens feel as if clicks were arriving through syrup. The
         compositor still handles this render transform without relayout, but
         releasing the pointer now restores the control in the same frame. -->
    <Style Selector=":is(Button)">
      <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector=":is(Button):pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)"/>
    </Style>
    <!-- No brush transitions on hover. Cross-fading the background and the
         border meant that dragging the pointer across neighbouring controls
         read as a flash, which the tester called out as ugly. Hover states
         land instantly; only the press scale animates. -->

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
      <Setter Property="MinWidth" Value="{DynamicResource ControlHeight}"/>
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource HairlineThickness}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadiusCorner}"/>
      <Setter Property="Padding" Value="{DynamicResource ControlPadding}"/>
      <!-- Short labels like "Clear" sat left of center inside the 48px
           minimum size; buttons that really want left content set it
           themselves (ProblemsToggle, card, "+ Add" rows). -->
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Focus ring: bold, offset, theme-aware, on every interactive control. -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter,
                     ToggleButton:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <!-- ComboBox/AutoCompleteBox focus their inner template parts, so use
         :focus-within (Codex: :focus-visible can miss the focused inner element). -->
    <Style Selector="TextBox:focus-within, ComboBox:focus-within, AutoCompleteBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.quiet PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Button.danger PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style Selector="ToggleButton.zone">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="{DynamicResource ZonePadding}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Selection = a bold blue OUTLINE, never a solid fill. Fluent's default
         ToggleButton paints the ContentPresenter with the accent colour when
         checked, which buries the label; every checked/hover state below pins
         the fill back to a readable surface so only the border reads as
         "selected". -->
    <Style Selector="ToggleButton.zone /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    <Style Selector="ToggleButton.zone:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
    </Style>
    <!-- Selected = a light, readable blue wash + a bold accent ring. InputTint
         is contrast-verified against the primary text colour, so the label
         stays legible (unlike the old solid-accent fill). BorderBrush is set on
         the ContentPresenter too, because Fluent's checked template otherwise
         overrides the templated-parent border. -->
    <Style Selector="ToggleButton.zone:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="ToggleButton.zone:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.zone:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Round icon button used for the "?" help dots and the compact delete
         control, so no user-visible control is ever a bare capital letter. -->
    <!-- Toolbar rows are WrapPanels so no command can be pushed off the edge
         of a narrow (or scaled-up) window. Avalonia 11.1's WrapPanel has no
         Spacing, so the gap is a margin on each child: the right half is the
         gap along a line, the bottom half is the gap between wrapped lines.
         A child with its own Margin in the XAML (the thin separators) keeps
         it, since a local value beats a style setter. -->
    <Style Selector="WrapPanel.toolbar > :is(Control)">
      <Setter Property="Margin" Value="0,0,10,6"/>
    </Style>

    <!-- Rocker-switch bank: the three view-mode buttons share one track so
         the mutual-exclusivity reads visually, not just via the "primary"
         fill on whichever is active. -->
    <Style Selector="Border.switchtrack">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource HairlineThickness}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource TrackRadiusCorner}"/>
      <Setter Property="Padding" Value="{DynamicResource TrackPadding}"/>
    </Style>
    <Style Selector="Button.switchkey">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CellRadiusCorner}"/>
    </Style>
    <Style Selector="Button.switchkey:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- A mouse click both focuses and hovers the same button, so the
         pointerover rule above would otherwise clobber the focus ring
         (Codex review). Restore it when both states are true. -->
    <Style Selector="Button.switchkey:pointerover:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
    </Style>

    <!-- 40 is the floor for a click target in a dense desktop layout, and these
         users aim with a mouth stick or a head mouse, so the round controls
         (delete, move, help) get the full 40 rather than the old 34. -->
    <Style Selector="Button.icon">
      <Setter Property="MinWidth" Value="{DynamicResource IconButton}"/>
      <Setter Property="MinHeight" Value="{DynamicResource IconButton}"/>
      <Setter Property="Width" Value="{DynamicResource IconButton}"/>
      <Setter Property="Height" Value="{DynamicResource IconButton}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource IconRadiusCorner}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- An editor command: Save, Undo, Save as template. A square plate rather
         than the round chip these used to be, so they read as the same kind of
         thing as Install rather than as three small ornaments beside it, and
         big enough to aim at with a mouth stick. -->
    <Style Selector="Button.command">
      <Setter Property="Width" Value="{DynamicResource CommandButton}"/>
      <Setter Property="Height" Value="{DynamicResource CommandButton}"/>
      <Setter Property="MinWidth" Value="{DynamicResource CommandButton}"/>
      <Setter Property="MinHeight" Value="{DynamicResource CommandButton}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadiusCorner}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.command PathIcon">
      <Setter Property="Width" Value="{DynamicResource CommandIcon}"/>
      <Setter Property="Height" Value="{DynamicResource CommandIcon}"/>
    </Style>

    <!-- Install is the one destination in the bar, so it is the tallest thing
         in it and carries the biggest glyph. -->
    <Style Selector="Button.install">
      <Setter Property="MinHeight" Value="{DynamicResource CommandButton}"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="{DynamicResource SubheadSize}"/>
    </Style>
    <Style Selector="Button.install PathIcon">
      <Setter Property="Width" Value="{DynamicResource InstallIcon}"/>
      <Setter Property="Height" Value="{DynamicResource InstallIcon}"/>
    </Style>

    <!-- A dropped menu is a panel like any other panel in the app: same plate,
         same hairline, same corner. Fluent&apos;s default drew a thin system
         popup with 12px items that did not belong to anything else on screen. -->
    <Style Selector="FlyoutPresenter, MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource HairlineThickness}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelRadiusCorner}"/>
      <Setter Property="Padding" Value="{DynamicResource MenuPadding}"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
      <Setter Property="Padding" Value="{DynamicResource ControlPadding}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource CellRadiusCorner}"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="AutoCompleteBox">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
    </Style>
    <!-- No MinHeight or Padding: the Fluent template pins the glyph in a
         Top-aligned Height=32 box no setter can move. The default MinHeight
         (32) already lines glyph and text up, so making the control taller
         only pushes the text and leaves the glyph stuck at the top. -->
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <!-- A PathIcon takes its colour from the Fluent icon style, not from the
         button it sits in, so the glyph kept the ordinary text colour while the
         label went to OnAccent. On the Import button that came out exactly
         inverted: black glyph beside white words in light, white glyph beside
         black words in dark. -->
    <Style Selector="Button.primary PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>

    <!-- The brand is a real button but must not look like one sitting in the
         chrome: no plate until you point at it. -->
    <Style Selector="Button.shellbrandbutton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelRadiusCorner}"/>
    </Style>
    <Style Selector="Button.shellbrandbutton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- A view key carries a picture over its word, so it needs height and a
         wide enough plate that the three read as one bank of switches. -->
    <Style Selector="Button.viewkey">
      <Setter Property="MinWidth" Value="74"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="{DynamicResource SmallSize}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.card">
      <Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource HairlineThickness}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelRadiusCorner}"/>
      <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
      <Setter Property="MinWidth" Value="{DynamicResource CardWidth}"/>
      <Setter Property="MinHeight" Value="{DynamicResource CardHeight}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <!-- Flat "panel plate" look: a hairline edge reads as a real boundary,
         not a soft drop shadow floating over the background. -->
    <Style Selector="Button.card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- No plate of its own. Each Home section used to be a filled, bordered
         panel holding filled, bordered cards, so every screen was a box inside
         a box and one sentence about the device took a 160px-tall container.
         Sections are a heading plus their content now; the cards are the only
         thing drawing a surface, which is what makes them read as objects. -->
    <Style Selector="Border.homepanel">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
    <Style Selector="Button.homeaction">
      <Setter Property="MinWidth" Value="154"/>
      <Setter Property="MinHeight" Value="104"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelRadiusCorner}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.homeaction.featured">
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.homeaction.featured /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <!-- Quiet by default. Five 36px accent icons in a row all shouted at the
         same volume, so the card that matters had nothing to win with. Only
         the featured one is blue; hovering lights the rest. -->
    <Style Selector="Button.homeaction PathIcon">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.homeaction.featured PathIcon">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.homeaction:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.homeaction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.brandmark">
      <Setter Property="FontFamily" Value="{DynamicResource BrandFont}"/>
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="2"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Section labels use sentence case and moderate weight. Heavy tracked
         capitals made every panel shout at the same level as the page title.
         Tracking goes slightly negative instead: at 22px, default spacing
         reads loose and the heading stops holding together as one word. -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource SectionSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="-0.2"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.cardsub">
      <Setter Property="FontSize" Value="{DynamicResource SmallSize}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="250"/>
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
  </Application.Styles>
</Application>
