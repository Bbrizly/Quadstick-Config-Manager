<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuadStick.Core</RootNamespace>
    <Version>1.0.0</Version>
    <!-- QuadStick semantics are safety-critical and deliberately dependency-light. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Validation/Resources/validation.json" LogicalName="ValidationJson" />
    <EmbeddedResource Include="Preferences/Resources/preferences.json" LogicalName="PreferencesJson" />
    <EmbeddedResource Include="Templates/Resources/default-template.csv" LogicalName="DefaultTemplate" />
  </ItemGroup>
</Project>
