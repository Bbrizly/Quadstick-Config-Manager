<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
  </RunConfiguration>
  <xUnit>
    <!-- App tests mutate process-global localization/culture state. Running test
         collections concurrently lets Arabic/pseudo locale leak into unrelated
         UI assertions. Keep the frozen assertions; make their process-global
         state deterministic instead. -->
    <parallelizeTestCollections>false</parallelizeTestCollections>
    <maxParallelThreads>1</maxParallelThreads>
  </xUnit>
</RunSettings>
