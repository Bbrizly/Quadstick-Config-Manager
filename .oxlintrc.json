{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2023": true
  },
  "ignorePatterns": [
    "dist-ui",
    "dist",
    "node_modules",
    "src/QuadStick.App",
    "src/QuadStick.Format",
    "src-tauri/gen",
    "target",
    "agent",
    "docs",
    "tools",
    "ios"
  ],
  "rules": {
    "no-console": "error",
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@tauri-apps/*", "@tauri-apps/**"],
            "message": "Go through src/platform/qcmClient. Only tauriQcmClient.ts may import the Tauri API, so every screen can render in a browser against MockQcmClient."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/platform/tauriQcmClient.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
